generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  name            String?
  passwordHash    String
  role            String          @default("USER")
  plan            String          @default("free") // "free" | "pro"
  prefsJson       String?                          // JSON blob — display, AI, privacy prefs
  emailVerifiedAt DateTime?                        // null = signed up but hasn't verified email yet
  // Account-wide profile fields. Mobile + web both read/write via /api/me/profile.
  // avatarData is the raw base64 string (no data: prefix); the API returns it
  // wrapped in a data URL the client can drop into <img> / <Image> directly.
  company         String?
  phone           String?
  avatarMime      String?                          // "image/jpeg" | "image/png" | "image/webp"
  avatarData      String?                          // base64-encoded image; capped server-side
  // Pro entitlement bookkeeping. Source of truth lives in RevenueCat;
  // the webhook at /api/billing/revenuecat keeps `plan` in sync.
  sonnetUsesUsed   Int       @default(0)             // lifetime cascade escalations to Sonnet (free users capped at 15)
  proSince         DateTime?                         // set when plan flipped to "pro"
  proSource        String?                           // "revenuecat" | "admin" | null
  revenueCatUserId String?   @unique                 // RC app_user_id; equals our User.id by convention
  createdAt       DateTime        @default(now())
  shipments     Shipment[]
  favourites    HSFavourite[]
  accounts      Account[]
  sessions      Session[]
  hsHistory     HsSearchHistory[]
  apiTokens     ApiToken[]
  pushTokens    DevicePushToken[]
  notificationPrefs NotificationPrefs?
  notifications Notification[]
}

// Long-lived bearer tokens for the mobile app. Plaintext is shown once at
// creation and stored only as bcrypt hash. Revoke by setting revokedAt.
model ApiToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String                       // e.g. "Tim's iPhone", "Warehouse iPad"
  tokenHash   String    @unique            // bcrypt hash — plaintext never stored
  prefix      String                       // first 8 chars of plaintext for display
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?

  @@index([userId])
}

// Global cache — keyed by normalised description so any user benefits from a prior lookup
model HsLookupCache {
  id              String   @id @default(cuid())
  descriptionNorm String   @unique
  description     String
  resultJson      String
  hitCount        Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Per-user search history (references cache row; also stores result for instant replay)
model HsSearchHistory {
  id            String   @id @default(cuid())
  userId        String
  description   String
  shortLabel    String?
  hs6           String?
  cn8           String?
  dutyRate      Float?
  confidencePct Int?
  fromCache     Boolean  @default(false)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Shipment {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  label         String?
  originCountry String
  incoterm      String
  currency      String
  exchangeRate  Float
  rateDate      String
  lines         String
  cifEUR        Float
  customsDuty   Float
  importVAT     Float
  total         Float
  notes         String?
}

model HSFavourite {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hsCode         String
  description    String
  shortLabel     String?
  dutyRate       Float
  notes          String?
  reasoning      String?
  confidencePct  Int?
  sensitiveGoods String?  // JSON payload: { category, warning, licenceAuthority?, regulations?, consequences? }
  createdAt      DateTime @default(now())
  @@unique([userId, hsCode])
}

model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  usedBy    String?
  createdBy String
  expiresAt DateTime?
  sentTo    String?
}

// Short-lived 6-digit codes for email verification (after signup) and password
// reset. Plaintext code is never stored — only the bcrypt hash. Row is consumed
// on successful verify (consumedAt set) and can no longer be used. The `purpose`
// column scopes a code to one flow, so a signup-verification code can't be
// replayed against the password-reset endpoint and vice-versa.
model OtpCode {
  id         String    @id @default(cuid())
  email      String                        // normalised: trimmed + lowercased
  codeHash   String                        // bcrypt hash of the 6-digit code
  purpose    String    @default("verify_email") // "verify_email" | "reset_password"
  attempts   Int       @default(0)         // failed verify attempts; cap at 5
  createdAt  DateTime  @default(now())
  expiresAt  DateTime                      // typically createdAt + 10 minutes
  consumedAt DateTime?                     // set on successful verify
  ip         String?                       // requester IP for rate-limit forensics

  @@index([email, purpose, createdAt])
  @@index([createdAt])
}

// Expo push token per device. One user can have many rows (phone, tablet).
// Row exists only while the master push toggle is ON on that device —
// DELETE /api/me/push-token removes it. Delivery gates live on
// NotificationPrefs (per user), not here.
model DevicePushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique   // Expo push token "ExponentPushToken[...]"
  platform  String             // "ios" | "android" | "web"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Per-user notification preferences. One row per user, mirrors the mobile
// client toggles 1:1 so the server can decide whether to enqueue a push or
// send an email without re-deriving state.
model NotificationPrefs {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  pushEnabled        Boolean  @default(true)          // master
  pushNewResults     Boolean  @default(true)
  pushLowConfidence  Boolean  @default(true)
  pushBilling        Boolean  @default(true)          // "subscription reminders"
  pushProductUpdates Boolean  @default(false)
  emailEnabled       Boolean  @default(true)          // marketing/product emails

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// TARIC geographical area — either a country (code = ISO2, e.g. "JP")
// or a country-group / agreement zone (code = numeric id, e.g. "1008",
// "2020"). Populated monthly from the CIRCABC "TARIC and Quota data"
// library via scripts/ingest-taric-zones.js. Used to resolve the
// geographical_area field on preferential measures returned by TARIC
// SOAP into a human-readable agreement name (e.g. "EPA Japan").
model TaricGeoArea {
  code        String            @id
  acronym     String?
  description String
  startDate   DateTime?
  endDate     DateTime?
  isCountry   Boolean           @default(false)
  updatedAt   DateTime          @updatedAt
  members     TaricZoneMember[]
}

// Membership edge from a country-group zone to a member country.
// One row per (zoneCode, memberCode, membershipStart) since a country
// can join and leave a group multiple times over the years.
model TaricZoneMember {
  id              String       @id @default(cuid())
  zoneCode        String
  memberCode      String
  membershipStart DateTime?
  membershipEnd   DateTime?
  zone            TaricGeoArea @relation(fields: [zoneCode], references: [code], onDelete: Cascade)

  @@unique([zoneCode, memberCode, membershipStart])
  @@index([memberCode])
}

// Durable inbox entry — one row per push we dispatched (or would have
// dispatched if the user was muted). The mobile app renders these in a
// bell-icon notification centre so users can catch up on missed banners.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String               // "newResults" | "lowConfidence" | "billing" | "productUpdates"
  title     String
  body      String
  data      String?              // JSON blob — whatever was put on the push payload
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
}
